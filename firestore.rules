rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() { 
      return request.auth != null; 
    }

    match /artifacts/{appId}/public/data/attendance/{docId} {
      // Allow any anonymous user to submit attendance and list records
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
    
    match /artifacts/{appId}/public/data/settings/{docId} {
      // Allow any anonymous user to read/write settings
      allow read, write: if isSignedIn();
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
